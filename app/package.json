{
  "name": "pindi-boys-fleet",
  "version": "0.1.0",
  "description": "Fleet and rental management system for Pindi Boys Car Rental L.L.C.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "seed": "node src/seed.mjs",
    "reseed": "node src/seed.mjs --reset",
    "demo": "node src/demo.mjs",
    "test": "node --test test/*.test.mjs",
    "chart": "node -e \"import('./src/chart.mjs').then(m=>m.syncChart())\""
  }
}
